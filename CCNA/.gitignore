# Python bytecode from tools/
__pycache__/
*.pyc

# LaTeX intermediates. The .pdf is deliberately NOT ignored -- this repo
# tracks the built volume so it can be read without a TeX installation.
*.aux
*.fdb_latexmk
*.fls
*.listing
*.out
*.synctex.gz
*.bbl
*.blg
*.idx
*.ilg
*.ind

# .log, .toc and .lof are also intermediates, but logcheck.py reads the log
# and the toc/lof settle after two passes, so they are left tracked to keep
# a clean checkout reproducible without a build.

%---------------------------------------------------------------------
% Figures. Every figure goes through \ccnafig so it is numbered,
% captioned, labelled and collected in the List of Figures. Content
% wider than the text block is scaled down; content that fits is left
% untouched, so it is impossible for a figure to overflow the margin.
%---------------------------------------------------------------------
\newcommand{\ccnafitw}[1]{%
  \resizebox{\ifdim\width>\linewidth \linewidth\else \width\fi}{!}{#1}}

\newcommand{\ccnafig}[3]{%
  \begin{figure}[htbp]
    \centering
    \ccnafitw{#1}
    \caption{#2}\label{fig:#3}
  \end{figure}}

% Same, forced in place, for a diagram that must not drift.
\newcommand{\ccnafigh}[3]{%
  \begin{figure}[H]
    \centering
    \ccnafitw{#1}
    \caption{#2}\label{fig:#3}
  \end{figure}}

\captionsetup{font=small, labelfont={bf,color=primary}, skip=6pt,
              justification=centering, width=0.92\linewidth}

% Front-matter and part-opener figures sit outside any chapter, so the
% default chapter.n scheme would give them a misleading number.
\newcommand{\structuralfigures}[1]{%
  \setcounter{figure}{0}%
  \renewcommand{\thefigure}{#1\arabic{figure}}%
  \setcounter{table}{0}%
  \renewcommand{\thetable}{#1\arabic{table}}}
\newcommand{\normalfigures}{%
  \renewcommand{\thefigure}{\thechapter.\arabic{figure}}%
  \renewcommand{\thetable}{\thechapter.\arabic{table}}}

% ...and every chapter must take it back. Without this the prefix set by
% the part opener stays in force for the whole part, and because
% report.cls resets the figure counter at each \chapter, EVERY chapter
% figure in the part comes out numbered "PN.1" -- five different figures
% sharing one number, with the List of Figures pointing at all of them.
% Do it here rather than asking 34 chapter files to remember.
\AddToHook{cmd/chapter/before}{\normalfigures}


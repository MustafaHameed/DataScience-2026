%=====================================================================
% TOPOLOGY DIAGRAMS
%
% Devices are nodes carrying a Font Awesome glyph over a bold label,
% coloured by the domain they mostly belong to. Drawn natively so the
% document stays self-contained -- no external image files anywhere.
%
%   \begin{topology}
%     \Sw{S1}{(0,0)}{SW1}
%     \Rtr{R1}{(4,0)}{R1}
%     \wire{S1}{R1}{Gi0/1}
%   \end{topology}
%=====================================================================
\tikzset{
  dev/.style={rounded corners=3pt, draw=#1, fill=#1!8, text=#1!45!black,
              line width=0.9pt, minimum width=1.45cm, minimum height=1.05cm,
              align=center, font=\scriptsize\bfseries, inner sep=2pt},

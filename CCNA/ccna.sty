%=====================================================================
%  ccna.sty
%  Style and pedagogy package for the CCNA 200-301 v2.0 course volume.
%
%  The third sibling of ../Data Science Fall 2026/dshandout.sty and
%  ../HEC AI-DS Curriculum Map/hecmap.sty: same palette, same
%  typographic decisions, and the same hard-won line-breaking rules.
%
%  What is new here, and why: v2.0 is 55% configure-or-troubleshoot
%  (8 of its 29 topics begin "Configure", 8 begin "Troubleshoot" or
%  "Diagnose", only 6 begin "Describe"). A handout for it cannot be
%  prose with a lab bolted on the end, so this file adds three
%  first-class environments -- config, verify and breakfix -- and a
%  blueprint tag that makes every chapter's exam coverage auditable.
%=====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ccna}[2026/08/27 CCNA 200-301 v2.0 course volume style]

%---------------------------------------------------------------------
% Packages
%---------------------------------------------------------------------
\RequirePackage[margin=2.4cm,top=2.6cm,bottom=2.4cm]{geometry}
% Latin Modern + T1 before microtype: the default CM fonts include
% bitmap variants, and microtype's font expansion is a fatal error on
% any non-scalable font. lmodern is scalable Type1 throughout.
\RequirePackage{lmodern}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{textcomp}
\RequirePackage{microtype}
% Latin Modern Roman has no bold small-caps shape (T1/lmr/bx/sc does
% not exist), so asking for bold small caps silently loses the caps.
% Kickers are medium-weight small caps, letterspaced.
\SetTracking{encoding=*, shape=sc}{45}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,shapes.geometric,shapes.misc,arrows.meta,positioning,
                calc,fit,backgrounds,decorations.pathreplacing,
                decorations.markings,patterns,chains}
\RequirePackage{colortbl}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{ragged2e}
\RequirePackage{tabularx}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{listings}
\RequirePackage{amsmath,amssymb}
\RequirePackage{multirow}
\RequirePackage{multicol}
\RequirePackage{fontawesome5}
\RequirePackage{listings}
\RequirePackage{float}
\RequirePackage{caption}
% Conceptual diagrams are tightly coupled to the text that introduces
% them, so a float must never drift past its own section heading.
\RequirePackage[section]{placeins}
\RequirePackage{needspace}
\RequirePackage{emptypage}
\RequirePackage{hyperref}
\RequirePackage{bookmark}

%---------------------------------------------------------------------
% Spacing and line breaking
%---------------------------------------------------------------------
\setlength{\parskip}{3pt plus 1pt minus 1pt}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{3em}
% A single line stranded at the top or bottom of a page is the most
% common way a printed handout loses a reader mid-argument.
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
% brokenpenalty stays finite: forbidding a break after a hyphenated
% line as well leaves TeX no legal break at all on figure-heavy pages.
\brokenpenalty=4000
\renewcommand{\arraystretch}{1.18}

% Table paragraph columns here are narrow and hold ordinary prose.
% Justifying them opens rivers and forces underfull lines, so every one
% is set ragged right with hyphens made expensive. Use L{<width>}
% wherever you would otherwise write p{<width>}.
\setlength{\RaggedRightRightskip}{0pt plus 4em}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash\hyphenpenalty=2000\relax}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
% Monospace column, for addressing tables and command references.
\newcolumntype{M}[1]{>{\RaggedRight\arraybackslash\ttfamily\footnotesize}p{#1}}

% snake_case and interface names appear inline throughout, and TeX has
% no break point inside one. Allow a break after an underscore; no
% hyphen is inserted, and maths is left alone.
\let\ccnaunderscore\_
\renewcommand{\_}{\ccnaunderscore\ifmmode\else\allowbreak\fi}

% Float placement: keep a figure on the page that discusses it.
%
% bottomfraction is deliberately well below topfraction. A tall figure
% attached to the BOTTOM of a page that LaTeX has already filled with
% text overflows it -- the symptom is "Overfull \vbox has occurred while
% \output is active", with no file or line to point at, and the caption
% printing below the footer rule. Bottom floats here are therefore
% capped at a little over a third of the page; tall figures go to the
% top, or to a float page.
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.75}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.70}


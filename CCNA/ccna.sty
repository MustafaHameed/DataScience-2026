%---------------------------------------------------------------------
% verify -- the show command that proves it worked.
%
%   \begin{verify}{SW1}{show interfaces trunk}
%
% Two arguments, device then command, so that the "#" of the prompt is
% produced here rather than escaped by hand in every one of the many
% hundreds of these blocks in the volume. A raw # in a tcolorbox title
% is an "Illegal parameter number" error, and remembering that is not
% the chapter author's job.
%---------------------------------------------------------------------
\newtcblisting{verify}[2]{%
  listing only, listing style=iosout,
  enhanced, breakable,
  colback=white, colframe=primary!70,
  colbacktitle=primary!70, coltitle=white,
  title={\faIcon{search}~\texttt{#1\#\ #2}}, fonttitle=\bfseries\footnotesize,
  boxrule=0.5pt, leftrule=4pt, arc=2pt,
  top=3pt, bottom=3pt, left=7pt, right=7pt,
  before skip=7pt, after skip=7pt}

%---------------------------------------------------------------------
% hostcmd -- a command run on an end host rather than on IOS: dig,
% nslookup, ipconfig, ip addr. Topic 1.6 names Windows, macOS and Linux

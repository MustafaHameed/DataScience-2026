%=====================================================================
% BLUEPRINT TAGS
%
% \bp{2.1,2.2} under a chapter title states which exam topics that
% chapter discharges; \tp{2.1} does the same inline in prose. The
% colour comes from the leading digit, so the domain is legible at a
% glance. Write the list WITHOUT spaces: \bp{2.1,2.2,2.5}.
%
% These tags are also the data behind the coverage matrix in
% Appendix D -- tools/check_coverage.py greps them out of parts/ and
% checks all twenty-nine topics are accounted for.
%=====================================================================
\def\ccna@bpsplit#1.#2\relax{%
  \edef\ccna@dc{dom\ifcase#1 1\or1\or2\or3\or4\or5\else5\fi}%
  \tikz[baseline=(bx.base)]{%
    \node[inner xsep=2.5pt, inner ysep=1pt, rounded corners=1.5pt,
          fill=\ccna@dc!12, draw=\ccna@dc!45, line width=0.4pt,
          text=\ccna@dc!85!black, font=\scriptsize\bfseries] (bx) {#1.#2};}}
\newcommand{\tp}[1]{\ccna@bpsplit#1\relax}

\makeatletter
\newcommand{\bp}[1]{%
  \par\nobreak\vspace{-2pt}%
  \noindent{\scriptsize\color{neutral}\textsc{Exam topics}}\hspace{4pt}%
  \@for\ccna@t:=#1\do{\expandafter\tp\expandafter{\ccna@t}\hspace{2.5pt}}%
  \par\vspace{7pt}\nobreak}
\makeatother

% The five domains, for openers and the coverage matrix.
\newcommand{\domname}[1]{%
  \ifcase#1 \or Network Infrastructure and Connectivity\or
  Switching and Network Access\or IP Routing\or
  Network Services and Security\or AI, Network Operations and Management\fi}
\newcommand{\domweight}[1]{%
  \ifcase#1 \or 25\%\or 25\%\or 20\%\or 20\%\or 10\%\fi}


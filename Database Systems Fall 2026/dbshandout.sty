%=====================================================================
% DATABASE SYSTEMS ONLY: the furniture a relational-model course needs
%
% Copied from dbshandout.sty, where \uiel and \adminpath stood here --
% a control label and a click trail, for a course taught through a
% graphical admin panel.  Both are removed rather than left in place.
% This course's laboratory is a command line and a SQL file; it never
% names a button, and a macro no chapter calls is a macro that will
% eventually be called by accident.
%
% In their place, three devices this course uses on almost every page.
% A database course writes relation schemas and functional dependencies
% by the dozen.  Left to ad-hoc markup they arrive as a mixture of
% italic, typewriter, "->" and "-->", which is unreadable in bulk, which
% breaks the moment an attribute name contains an underscore, and which
% the slide pipeline cannot style because it cannot recognise it.
%=====================================================================

%---------------------------------------------------------------------
% \relation{Student}{\relkey{roll\_no}, name, programme}
%
% A relation schema in the standard notation: the relation name in
% small caps, the attribute list in parentheses, and whichever
% attributes form the key underlined by \relkey.
%
% The key is marked by hand rather than assumed to be the first
% attribute, because a composite key is two or three of them and a
% foreign key is underlined differently in every textbook.  Making the
% author say which is the point: Chapter 8 is about the difference
% between declaring a key and having one.
%
% Deliberately distinct from \texttt (something typed literally into a
% terminal) and from \term (a concept being defined).  A relation schema
% is neither; it is a statement about the shape of the data.
%---------------------------------------------------------------------
% \normalfont before \scshape, in both macros below and in \sqlkw.
%
% Latin Modern Roman has no bold small-caps shape -- T1/lmr/bx/sc simply does
% not exist -- so \textbf{... \sqlkw{GRANT} ...} asks for a font that is not
% there, LaTeX substitutes bold upright, and THE SMALL CAPS SILENTLY VANISH.
% The handout's own build gate counts font warnings, so this surfaces; the
% first draft of Appendix A tripped it on "no \sqlkw{GRANT}, no \sqlkw{REVOKE}"
% inside a bold run.
%
% Forcing medium weight is the right fix rather than avoiding bold at the use
% sites: a keyword or a relation name is a distinct KIND of thing, not
% emphasis, and it should look the same whether the sentence around it is bold
% or not.  The .sty header makes the same choice for the part and chapter
% kickers, for the same reason.
% \relkey underlines, but not with \underline.  \underline sets its rule at a
% fixed depth below the baseline, ignoring what is in the box, and almost every
% key in this course is a name like roll_no, course_code or section_id.  The
% underscore of such a name sits at exactly that depth, so the rule and the
% underscore merge and \relkey{roll\_no} prints as roll__no -- which a student
% reading a schema will copy, and which is wrong.  Lowering the rule past the
% box's own depth separates the two, and also clears the descenders of p, g and
% y, which \underline does not.
\newlength{\dsklen}
\newcommand{\relkey}[1]{%
  \leavevmode
  \sbox0{#1}%
  \setlength{\dsklen}{\dp0}%
  \ifdim\dsklen<0.9ex\setlength{\dsklen}{0.9ex}\fi
  \hbox{\usebox0\kern-\wd0
        \raisebox{-\dimexpr\dsklen+1.3pt\relax}[0pt][0pt]{%
          \rule{\wd0}{0.4pt}}}}

% No padding inside the brackets.  The first draft wrote (\,...\,), and at
% \small the thin space reads as a typing error -- "programme )" -- rather than
% as typography.  Standard notation has none.
\newcommand{\relation}[2]{%
  {\normalfont\scshape\color{primary!85!black}#1}\allowbreak
  {\small(\ignorespaces#2\unskip)}}

% \ent{student} -- an entity type or relation named in running prose.
%
% Part II names entity types in almost every sentence, and plain \textsc is
% the wrong tool for it: inside \textbf it asks for T1/lmr/bx/sc, which the
% Latin Modern family does not have, and the build falls back to upright bold
% with a font warning.  That is the same trap \sqlkw and \relation were given
% \normalfont for, and it caught this handout a second time on
% "\textbf{3. \textsc{student} enrols in \textsc{section}}" in Chapter 6.
%
% Forcing medium weight is again the right fix rather than avoiding bold at
% the use sites: an entity type is a KIND of thing, not emphasis, and it
% should look the same in a bold heading as in a sentence.
\newcommand{\ent}[1]{{\normalfont\scshape#1}}

% \unk -- the third truth value, UNKNOWN, set as SQL texts set it.
%
% Same guard, same reason, third time: Chapter 14 titled a definition box
% [\textsc{unknown}], box titles are bold, and the build fell back to
% upright bold with a font warning. A truth value is a constant, not
% emphasis, and should look the same in a title as in a truth table.
\newcommand{\unk}{{\normalfont\scshape unknown}}

%---------------------------------------------------------------------
% \fd{sid, code}{grade} -- a functional dependency.
%
% Chapters 17 to 19 are unreadable without one.  The arrow is a real
% \rightarrow in maths mode rather than two hyphens, and the whole thing
% is \mbox-free so that a long dependency may break across a line --
% which the minimal-cover worked examples need, because they run to
% six or seven attributes on the left.
%
% \fdset is the same thing for a set of them, as F = { ... }.
%---------------------------------------------------------------------
\newcommand{\fd}[2]{%
  {\ignorespaces#1\unskip\ $\rightarrow$\ \ignorespaces#2\unskip}}
\newcommand{\fdset}[1]{$F = \{\,$#1$\,\}$}

%---------------------------------------------------------------------
% \sqlkw{SELECT} -- a SQL keyword inside running prose.
%
% Not \texttt: a keyword named in a sentence is not a thing the reader
% is being told to type, and setting it in the code face makes every
% paragraph that discusses SQL look like a listing.  Small caps, which
% is how every one of HEC's four reference books sets them.
%---------------------------------------------------------------------
\newcommand{\sqlkw}[1]{{\normalfont\scshape\MakeLowercase{#1}}}

%---------------------------------------------------------------------
% The measured box.
%
% Eleven of the twenty-three chapters carry an experiment; the other
% twelve argue in prose.  The Analysis of Algorithms handout ran its
% measurements as ordinary paragraphs because *every* chapter measured,
% so the strand needed no marking.  Here it is the lighter of the two
% strands and has to be visible, or a number the reader could have
% reproduced for themselves reads as one the author merely asserted.
%
% It matters more in this course than in any sibling, because almost
% every claim a database textbook makes is checkable in one line and
% almost none of them are ever checked.  "Indexes make queries faster"
% is the example the whole strand exists for.
%
% Graphite rather than another hue from the palette: every other colour
% is already spoken for (teal is the lab, gold the worked example, green
% the code example), and a near-white panel in a graphite frame reads
% like an instrument reading, which is what it is.
%---------------------------------------------------------------------
% The optional argument extends the title rather than replacing it, so that
% every box in the strand still announces itself as "Measured" and a reader
% can find them all by flicking through.  \ifstrempty (etoolbox, loaded
% above) keeps the untitled form from printing a dangling colon, which is a
% small blemish the sibling courses' \worked box does have.
\definecolor{measurehl}{HTML}{212F3D}
\newtcolorbox{measured}[1][]{
  enhanced, breakable,
  colback=measurehl!3, colframe=measurehl,
  colbacktitle=measurehl, coltitle=white,
  title={\faIcon{tachometer-alt}~Measured\ifstrempty{#1}{}{: #1}},
  fonttitle=\bfseries\small,
  boxrule=0pt, leftrule=4pt, arc=2pt,
  shadow={1mm}{-1mm}{0mm}{black!12},
  top=4pt, bottom=4pt, left=8pt, right=8pt
}

%---------------------------------------------------------------------
% Figures. Every figure in this handout goes through \dsfig so that it
% is numbered, captioned, labelled and collected in the List of Figures.
%
%   \dsfig{<tikz or pgfplots code>}{<caption>}{<label suffix>}
%---------------------------------------------------------------------
% \dsfitw caps a figure at the text width: content wider than the text block
% is scaled down proportionally, content that already fits is left untouched.
% This makes it impossible for a figure to overflow into the margin.
\newcommand{\dsfitw}[1]{%
  \resizebox{\ifdim\width>\linewidth \linewidth\else \width\fi}{!}{#1}}

\newcommand{\dsfig}[3]{%
  \begin{figure}[htbp]
    \centering
    \dsfitw{#1}
    \caption{#2}\label{fig:#3}
  \end{figure}}

% Same, but forced in place (for tightly-coupled diagrams).
\newcommand{\dsfigh}[3]{%
  \begin{figure}[H]
    \centering
    \dsfitw{#1}
    \caption{#2}\label{fig:#3}
  \end{figure}}
\captionsetup{font=small, labelfont={bf,color=primary}, skip=6pt,
              justification=centering, width=0.92\linewidth}

%---------------------------------------------------------------------
% Structural figures (front matter and part openers) sit outside any
% chapter, so the default \thechapter.\arabic{figure} scheme would give
% them a misleading chapter number. Give them their own prefix instead.
%   \structuralfigures{F.}   -> F.1, F.2, ...
%   \structuralfigures{P3.}  -> P3.1, ...
% \locator restores normal per-chapter numbering, so every chapter file
% is unaffected.
%---------------------------------------------------------------------
\newcommand{\structuralfigures}[1]{%
  \setcounter{figure}{0}%
  \renewcommand{\thefigure}{#1\arabic{figure}}%
  \setcounter{table}{0}%
  \renewcommand{\thetable}{#1\arabic{table}}}

\newcommand{\normalfigures}{%
  \renewcommand{\thefigure}{\thechapter.\arabic{figure}}%
  \renewcommand{\thetable}{\thechapter.\arabic{table}}}

%---------------------------------------------------------------------
% Chapter locator strip: shows where the chapter sits in the 6-part arc.
%   \locator{<part number 1-6>}{<part title>}
%---------------------------------------------------------------------
\newcommand{\locator}[2]{%
  \normalfigures
  \begingroup
  \noindent\begin{tikzpicture}[baseline]
    \foreach \i in {1,...,6}{
      \pgfmathsetmacro{\xx}{(\i-1)*2.42}
      \ifnum\i=#1
        \node[rounded corners=2pt, fill=primary, text=white, font=\scriptsize\bfseries,
              minimum width=2.3cm, minimum height=0.42cm] at (\xx,0) {Part \i};
      \else
        \node[rounded corners=2pt, fill=primary!10, text=primary!60, font=\scriptsize,
              minimum width=2.3cm, minimum height=0.42cm] at (\xx,0) {Part \i};
      \fi}
  \end{tikzpicture}\\[2pt]
  {\small\itshape\color{secondary}#2}\par\vspace{4pt}
  \endgroup}


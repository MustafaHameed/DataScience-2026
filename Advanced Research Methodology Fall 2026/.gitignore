# LaTeX build artefacts -- regenerate with .\build.ps1
*.aux
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.toc
*.synctex.gz

# biber / biblatex artefacts
*.bbl
*.bcf
*.blg
*.run.xml

# temporary verification builds (see README)
ARM_check.*
ARM_nologo.*

# slide generator -- the decks in slides/out/ are regenerated by
# slides/build_slides.py. Tracking them is a judgement call: they are a
# deliverable like the PDF, but 34 binaries churn on every rebuild.
slides/__pycache__/

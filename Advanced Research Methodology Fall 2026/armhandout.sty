%=====================================================================
%  armhandout.sty
%  Shared style + pedagogy package for the
%  Advanced Research Methodology Master Handout (MS IT / PhD IT)
%
%  Derived from dshandout.sty (Data Science Fall 2026). The typographic
%  engineering -- font choice, ragged table columns, float placement,
%  widow control -- is carried over unchanged, and the comments explaining
%  why each decision was made are preserved with it. What differs:
%  the teal palette, the running heads, a real biblatex bibliography,
%  the four-traditions block in place of the four-lenses block, and four
%  discipline-specific boxes: regbox, paperbox, templatebox, vignette.
%
%  Single source of truth for colours, boxes, figures and the
%  per-chapter pedagogical furniture. Do not duplicate this preamble
%  into individual part files.
%=====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{armhandout}[2026/09/02 Advanced Research Methodology handout style]

%---------------------------------------------------------------------
% Packages
%---------------------------------------------------------------------
\RequirePackage[margin=2.4cm,top=2.6cm,bottom=2.4cm]{geometry}
% Latin Modern + T1 before microtype: the default CM fonts include bitmap
% variants (notably TS1 cmtt), and microtype's font expansion is a fatal
% error on any non-scalable font. lmodern is scalable Type1 throughout.
\RequirePackage{lmodern}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{textcomp}
\RequirePackage{microtype}
% Latin Modern Roman has no bold small-caps shape (T1/lmr/bx/sc does not
% exist), so asking for bold small caps silently loses the caps. The part and
% chapter kickers therefore use medium-weight small caps, letterspaced --
% which is what a kicker wants anyway. Tracking needs microtype's tracking
% feature, which is available under pdfTeX.
\SetTracking{encoding=*, shape=sc}{45}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,shapes.geometric,shapes.misc,arrows.meta,positioning,calc,fit,
                backgrounds,shadows.blur,decorations.pathmorphing,
                decorations.pathreplacing,decorations.markings,patterns,matrix,
                chains,intersections,through,angles,quotes}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween,statistics,groupplots,dateplot}
\RequirePackage{colortbl}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{tabularx}
% ragged2e, not the kernel's \raggedright: \RaggedRight caps the stretch it
% allows and keeps hyphenation on, so a 2.5 cm column comes out with a soft
% right edge instead of a saw-toothed one.
\RequirePackage{ragged2e}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage[most]{tcolorbox}
\RequirePackage{multicol}
\RequirePackage{amsmath,amssymb}
\RequirePackage{multirow}
\RequirePackage{setspace}
\RequirePackage{fontawesome5}
\RequirePackage{listings}
\RequirePackage{float}
\RequirePackage{caption}
% Figures here are conceptual diagrams tightly coupled to the text that
% introduces them, so a float must never drift past its own section heading.
\RequirePackage[section]{placeins}
\RequirePackage{emptypage}
% A section heading must not be stranded at the foot of a page: the float that
% follows it has nowhere to go and prints over the footer. \Needspace reserves
% room for the heading plus the first few lines or the top of the first figure.
\RequirePackage{needspace}
% hidelinks is deliberately not used: the \hypersetup below turns colourlinks
% on, which would override it anyway. Links are coloured, never boxed.
\RequirePackage{hyperref}
\RequirePackage{bookmark}

% A handout that teaches citation practice has to model it, so every claim
% resting on a source carries a real \cite resolved by biber out of refs.bib.
% numeric-comp compresses [3,4,5] to [3-5], which matters in a methods text
% where one sentence can legitimately cite six guideline papers. csquotes is
% loaded first because biblatex warns when it is missing.
\RequirePackage[english]{babel}
\RequirePackage{csquotes}
\RequirePackage[style=numeric-comp,backend=biber,sorting=nyt,maxbibnames=6,
                minbibnames=3,giveninits=true,doi=true,url=true,
                isbn=false,eprint=true]{biblatex}

% In refs.bib, note = {openaccess} is authoring metadata: it records that the
% publisher version was verified free at the last link check, and it is what
% the \oa badge and the Appendix F access column are set from. It is not a
% note to the reader, and printing it drops a bare "openaccess" into the
% middle of a reference -- exactly the kind of leaked field a student would
% copy. Strip the flag at load time; keep any human-readable remainder, so
% "openaccess; cited by ..." still prints its second half.
\DeclareSourcemap{
  \maps[datatype=bibtex]{
    \map{
      \step[fieldsource=note, match=\regexp{\A\s*openaccess\s*;\s*}, replace={}]
    }
    \map{
      \step[fieldsource=note, match=\regexp{\A\s*openaccess\s*\Z}, final]
      \step[fieldset=note, null]
    }
  }
}

%---------------------------------------------------------------------
% Spacing
%---------------------------------------------------------------------
\setlength{\parskip}{3pt plus 1pt minus 1pt}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{3em}
% A single line of a paragraph stranded at the top or bottom of a page is the
% most common way a printed handout loses a reader mid-argument. Forbid it
% outright; there is enough stretch elsewhere on the page to absorb the cost.
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
% brokenpenalty stays finite: forbidding a break after a hyphenated line
% outright leaves TeX no legal break at all on some figure-heavy pages.
\brokenpenalty=4000
\renewcommand{\arraystretch}{1.15}

% Table paragraph columns in this handout are narrow (often under 4 cm) and hold
% ordinary prose. Justifying them opens rivers and forces hundreds of underfull
% lines, so every one of them is set ragged right. Use L{<width>} wherever you
% would otherwise write p{<width>}; the L type also restores the row-break
% command, which a >{...} declaration would otherwise shadow.
%
% ragged2e allows only 2 em of stretch, which in a 2.5 cm column is tight
% enough that TeX reaches for a hyphen on almost every line -- "Legal opera-
% tions" in a column head. Widen the allowance and make hyphens expensive, so
% they appear only for words that genuinely will not fit.
\setlength{\RaggedRightRightskip}{0pt plus 4em}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash\hyphenpenalty=2000\relax}p{#1}}

% snake_case identifiers appear inline in the prose throughout, and TeX has no
% break point inside one, so a long identifier near the end of a line forces an
% overfull box. Allow a break after an underscore. No hyphen is inserted, so the
% identifier stays readable across the break; maths is left alone.
\let\armunderscore\_
\renewcommand{\_}{\armunderscore\ifmmode\else\allowbreak\fi}

% Float placement: make LaTeX far more willing to keep a figure on the page
% that discusses it, rather than deferring it to a float page later.
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.75}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.70}

%---------------------------------------------------------------------
% Colour palette -- the teal set used by the two existing MSIT-level
% documents (Research_Methods_in_IT_Handout, MSIT_Synopsis_Guide_Demo),
% not the blue used by the BSIT handouts. Graduate material should read as
% a distinct family on a shelf.
%---------------------------------------------------------------------
\definecolor{primary}{HTML}{0E4D64}
\definecolor{secondary}{HTML}{137177}
\definecolor{accent}{HTML}{C84B31}
\definecolor{lightbg}{HTML}{E8F6F3}
\definecolor{defbg}{HTML}{FDF2E9}
\definecolor{greenhl}{HTML}{27AE60}
\definecolor{purplehl}{HTML}{6C5B7B}
\definecolor{codebg}{HTML}{F4F6F7}
\definecolor{goldhl}{HTML}{B7950B}
\definecolor{tealhl}{HTML}{117A65}
% A named neutral. Styles that build derived shades (#1!50!black) cannot take
% an already-mixed expression such as gray!60 as their argument, so figures
% needing a grey element use this instead.
\definecolor{neutral}{HTML}{707B7C}

% Fixed colour per research tradition -- these four never change, so a reader
% learns to recognise a tradition by its colour alone. They are the four ways
% computing research produces knowledge, and nearly every method in this book
% belongs to one of them.
\definecolor{tradEMPc}{HTML}{1F618D}   % Empirical / measurement    -- blue
\definecolor{tradDSRc}{HTML}{117864}   % Design science / artefact  -- teal
\definecolor{tradQUALc}{HTML}{6C3483}  % Qualitative / interpretive -- purple
\definecolor{tradFORMc}{HTML}{922B21}  % Formal / analytical        -- red

\hypersetup{
  colorlinks=true, linkcolor=primary, urlcolor=secondary, citecolor=primary,
  % The printed table of contents stops at section level (tocdepth=1), but the
  % PDF navigation pane is free, so let it go one level deeper. Parts and
  % chapters open by default; sections stay folded until wanted.
  bookmarksnumbered=true, bookmarksdepth=2,
  bookmarksopen=true, bookmarksopenlevel=1,
  % Document properties, so the file identifies itself in a reader's title bar,
  % in search results and in a library catalogue.
  pdftitle={Advanced Research Methodology --- Evidence, Design and Integrity in Computing Research},
  pdfauthor={Department of Information Technology, The Islamia University of Bahawalpur},
  pdfsubject={Master lecture handout for the MS IT and PhD IT Advanced Research
              Methodology course, Fall 2026},
  pdfkeywords={research methodology, systematic literature review, design science,
               empirical software engineering, experimental design, case study,
               survey research, reproducibility, research ethics, academic integrity,
               MS IT, PhD, IUB, lecture handout},
  pdfdisplaydoctitle=true}


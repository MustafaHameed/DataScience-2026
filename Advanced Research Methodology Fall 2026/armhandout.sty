%---------------------------------------------------------------------
% The four-traditions block -- the structural spine of the book. It appears
% once in every chapter, always with the same four traditions in the same
% order and the same colours, answering one question: what does this
% chapter's idea look like to each way of producing knowledge in computing?
%
% Usage:
%   \begin{traditions}{topic of this chapter}
%     \tradEMP{...} \tradDSR{...} \tradQUAL{...} \tradFORM{...}
%   \end{traditions}
%---------------------------------------------------------------------
\newcommand{\traditem}[3]{%
  \begin{tcolorbox}[enhanced, breakable, nobeforeafter,
    colback=#1!4, colframe=#1, boxrule=0pt, leftrule=3.5pt, arc=1.5pt,
    top=3pt, bottom=3pt, left=6pt, right=6pt, before skip=4pt, after skip=4pt]
    {\color{#1}\bfseries\small #2}\par\vspace{2pt}\small #3
  \end{tcolorbox}}

\newcommand{\tradEMP}[1]{\traditem{tradEMPc}{\faIcon{chart-line}~Empirical}{#1}}
\newcommand{\tradDSR}[1]{\traditem{tradDSRc}{\faIcon{drafting-compass}~Design Science}{#1}}
\newcommand{\tradQUAL}[1]{\traditem{tradQUALc}{\faIcon{comments}~Qualitative}{#1}}
\newcommand{\tradFORM}[1]{\traditem{tradFORMc}{\faIcon{square-root-alt}~Formal / Analytical}{#1}}

\newtcolorbox{traditions}[1]{
  enhanced, breakable,
  colback=white, colframe=primary!70!black,
  colbacktitle=primary!70!black, coltitle=white,
  title={\faIcon{compass}~Four Traditions --- #1 Across Ways of Knowing},
  fonttitle=\bfseries\small,
  boxrule=0.6pt, arc=2pt,
  shadow={1mm}{-1mm}{0mm}{black!12},
  top=4pt, bottom=4pt, left=6pt, right=6pt
}


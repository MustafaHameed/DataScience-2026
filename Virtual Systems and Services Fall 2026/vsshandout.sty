% VSS: this course's labs are shell, YAML, Dockerfiles and Terraform, not
% Python.  listings ships bash, C and XML; the other three are defined here.
% The slide pipeline reads the language= option off each lstlisting and maps
% it to a Pygments lexer, so these names must stay as they are spelled here.
%
% A lab listing is always pure ASCII: listings has no Unicode support under
% pdfLaTeX, so a stray arrow or non-breaking space is a compile error, not a
% typo.  Keep lines at or under 78 columns -- wider than that and the code
% panel on the slide has to shrink below the 10.5 pt floor.
\lstdefinelanguage{Dockerfile}{
  morekeywords={FROM,RUN,CMD,LABEL,MAINTAINER,EXPOSE,ENV,ADD,COPY,ENTRYPOINT,
                VOLUME,USER,WORKDIR,ARG,ONBUILD,STOPSIGNAL,HEALTHCHECK,SHELL,AS},
  morecomment=[l]{\#},
  morestring=[b]",
  morestring=[b]',
  sensitive=true
}
\lstdefinelanguage{YAML}{
  % YAML has no keywords in the usual sense; what a reader needs picked out is
  % the structural vocabulary of a Kubernetes manifest.
  morekeywords={apiVersion,kind,metadata,spec,template,containers,image,ports,
                name,labels,selector,replicas,resources,limits,requests,
                volumeMounts,volumes,env,command,args,namespace,type,
                targetPort,containerPort,matchLabels,restartPolicy,
                livenessProbe,readinessProbe,nodeSelector,true,false,null},
  morecomment=[l]{\#},
  morestring=[b]",
  morestring=[b]',
  sensitive=true
}
\lstdefinelanguage{HCL}{
  morekeywords={resource,provider,variable,output,module,data,locals,terraform,
                for_each,count,depends_on,source,type,default,value,required_providers},
  morecomment=[l]{\#},
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  sensitive=true
}


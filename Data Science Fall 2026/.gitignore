# LaTeX build artefacts -- regenerate with .\build.ps1
*.aux
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.toc
*.synctex.gz

# Slide build intermediates -- regenerate with slides\build_slides.py.
# The decks (slides/out), the figure renders (slides/figures/out) and the
# typeset maths and icons are tracked, so a checkout can rebuild the decks
# without TeX; the per-figure TeX runs and the QA renders are not.
slides/figures/build/
slides/render/
__pycache__/
*.pyc

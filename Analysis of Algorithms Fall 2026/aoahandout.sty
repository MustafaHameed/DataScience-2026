%=====================================================================
% AoA ONLY: theorems, proofs and pseudocode
%
% No sibling course needs these.  The systems courses state one theorem
% each and hand-roll it inside a conceptbox; this course states and
% proves several dozen results and must be able to write "by Lemma 6.2",
% so the environments are numbered and cross-referenceable.
%
% The division of labour is deliberate and is a slide decision as much
% as a typographic one:
%
%   theorem / lemma / corollary  are tcolorboxes, so the slide pipeline
%                                gives each one a card slide;
%   proof                        is plain amsthm prose, NOT a box, so it
%                                stays in the handout and reaches the
%                                slides as speaker notes.  A full proof
%                                on a slide is a bad slide; the statement
%                                belongs on the screen and the argument
%                                belongs in the lecturer's mouth.
%=====================================================================
\RequirePackage{amsthm}
\RequirePackage{algpseudocode}

% Numbered within the chapter, sharing one counter, so that Theorem 6.1 is
% followed by Lemma 6.2 and the reader can tell at a glance how far through
% the chapter a cited result sits.
\newcounter{aoathm}[chapter]
\renewcommand{\theaoathm}{\thechapter.\arabic{aoathm}}

% The counter is stepped by hand rather than through tcolorbox's own
% "use counter" machinery, which formats the value with \arabic and so
% prints "Theorem 1" where this book wants "Theorem 1.1".  \refstepcounter
% also makes \label point at the right number.
\newtcolorbox{aoa@resultbox}[3]{%
  enhanced, breakable,
  colback=#2!4, colframe=#2,
  colbacktitle=#2, coltitle=white,
  title={\faIcon{#3}~#1}, fonttitle=\bfseries\small,
  boxrule=0pt, leftrule=4pt, arc=2pt,
  shadow={1mm}{-1mm}{0mm}{black!12},
  top=4pt, bottom=4pt, left=8pt, right=8pt}

% \aoa@result{<env>}{<label text>}{<colour>}{<icon>}
%
% \@currentlabel is re-asserted inside the box because tcolorbox sets its own
% while opening, so a \label placed just after \begin{lemma} would otherwise
% resolve to the tcolorbox's number rather than to "6.2".
\newcommand{\aoa@result}[4]{%
  \newenvironment{#1}[1][]{%
    \refstepcounter{aoathm}%
    \edef\aoa@num{\theaoathm}%
    \begin{aoa@resultbox}%
      {#2~\aoa@num\ifstrempty{##1}{}{ --- ##1}}{#3}{#4}%
    \protected@edef\@currentlabel{\aoa@num}}%
    {\end{aoa@resultbox}}}

\aoa@result{theorem}{Theorem}{primary}{award}
\aoa@result{lemma}{Lemma}{secondary}{puzzle-piece}
\aoa@result{corollary}{Corollary}{tealhl}{angle-double-right}

% Proof: deliberately not a box.  amsthm's own style, with the house colour
% on the word "Proof" and a filled QED square.
\renewcommand{\qedsymbol}{$\blacksquare$}
\newtheoremstyle{aoaproof}{6pt}{6pt}{}{0pt}{\itshape\color{primary}}{.}{0.5em}{}
\theoremstyle{aoaproof}
\newenvironment{aoa@proof}{\begin{proof}}{\end{proof}}

% Pseudocode.  Algorithms are authored once, as the body of a \dsfig, so that
% the handout gets the textbook look AND the slide pipeline gets vector art
% with free line-by-line reveal through extract_figures.py's \stepvis build
% levels.  See ../README.md.
%
% algpseudocode's defaults are tuned for a two-column paper; these are tuned
% for a handout page and a 16:9 slide.
\algrenewcommand\algorithmicwhile{\color{primary}\textbf{while}}
\algrenewcommand\algorithmicdo{\color{primary}\textbf{do}}
\algrenewcommand\algorithmicend{\color{primary}\textbf{end}}
\algrenewcommand\algorithmicif{\color{primary}\textbf{if}}
\algrenewcommand\algorithmicthen{\color{primary}\textbf{then}}
\algrenewcommand\algorithmicelse{\color{primary}\textbf{else}}
\algrenewcommand\algorithmicfor{\color{primary}\textbf{for}}
\algrenewcommand\algorithmicforall{\color{primary}\textbf{for all}}
\algrenewcommand\algorithmicreturn{\color{primary}\textbf{return}}
\algrenewcommand\algorithmicrepeat{\color{primary}\textbf{repeat}}
\algrenewcommand\algorithmicuntil{\color{primary}\textbf{until}}
\algrenewcommand\algorithmicprocedure{\color{primary}\textbf{procedure}}
\algrenewcommand\algorithmicfunction{\color{primary}\textbf{function}}
\algrenewcommand{\alglinenumber}[1]{{\scriptsize\color{neutral}#1}}
% algpseudocode already defines \algorithmiccomment, used by \Comment; only
% its appearance is changed here.
\algrenewcommand{\algorithmiccomment}[1]{%
  \hfill{\color{neutral}\(\triangleright\)~\itshape #1}}

% \aoaalg{<title>}{<algpseudocode body>} -- the frame an algorithm sits in.
% Used inside \dsfig, so the caption and label come from \dsfig as usual.
\newcommand{\aoaalg}[2]{%
  \begin{tcolorbox}[enhanced, colback=codebg, colframe=primary,
                    colbacktitle=primary, coltitle=white,
                    title={\faIcon{list-ol}~#1}, fonttitle=\bfseries\small,
                    boxrule=0pt, leftrule=4pt, arc=2pt, width=0.92\linewidth,
                    top=4pt, bottom=4pt, left=8pt, right=8pt]
  \begin{algorithmic}[1]
  #2
  \end{algorithmic}
  \end{tcolorbox}}

% Algorithm names are set in small caps throughout -- \algname{Merge-Sort}.
%
% \textsc is not usable here: the \aoaalg box title and the theorem titles are
% \bfseries, and Latin Modern has no bold small caps (T1/lmr/bx/sc), so every
% algorithm named in a title would raise a font substitution warning. Forcing
% medium weight gives the same shape in prose and a deliberate, lighter weight
% against a bold title, which reads as intentional rather than broken.
\newcommand{\algname}[1]{{\mdseries\scshape #1}}

% Small helpers the analysis uses constantly.
\newcommand{\bigO}[1]{O(#1)}
\newcommand{\bigOm}[1]{\Omega(#1)}
\newcommand{\bigTh}[1]{\Theta(#1)}
\newcommand{\lgn}{\lg n}
\providecommand{\lg}{\operatorname{lg}}

%---------------------------------------------------------------------
% Figures. Every figure in this handout goes through \dsfig so that it
% is numbered, captioned, labelled and collected in the List of Figures.
%
%   \dsfig{<tikz or pgfplots code>}{<caption>}{<label suffix>}
%---------------------------------------------------------------------
% \dsfitw caps a figure at the text width: content wider than the text block
% is scaled down proportionally, content that already fits is left untouched.
% This makes it impossible for a figure to overflow into the margin.
\newcommand{\dsfitw}[1]{%
  \resizebox{\ifdim\width>\linewidth \linewidth\else \width\fi}{!}{#1}}

\newcommand{\dsfig}[3]{%
  \begin{figure}[htbp]
    \centering
    \dsfitw{#1}
    \caption{#2}\label{fig:#3}
  \end{figure}}

% Same, but forced in place (for tightly-coupled diagrams).
\newcommand{\dsfigh}[3]{%
  \begin{figure}[H]
    \centering
    \dsfitw{#1}
    \caption{#2}\label{fig:#3}
  \end{figure}}
\captionsetup{font=small, labelfont={bf,color=primary}, skip=6pt,
              justification=centering, width=0.92\linewidth}

%---------------------------------------------------------------------
% Structural figures (front matter and part openers) sit outside any
% chapter, so the default \thechapter.\arabic{figure} scheme would give
% them a misleading chapter number. Give them their own prefix instead.
%   \structuralfigures{F.}   -> F.1, F.2, ...
%   \structuralfigures{P3.}  -> P3.1, ...
% \locator restores normal per-chapter numbering, so every chapter file
% is unaffected.
%---------------------------------------------------------------------
\newcommand{\structuralfigures}[1]{%
  \setcounter{figure}{0}%
  \renewcommand{\thefigure}{#1\arabic{figure}}%
  \setcounter{table}{0}%
  \renewcommand{\thetable}{#1\arabic{table}}}

\newcommand{\normalfigures}{%
  \renewcommand{\thefigure}{\thechapter.\arabic{figure}}%
  \renewcommand{\thetable}{\thechapter.\arabic{table}}}

%---------------------------------------------------------------------
% Chapter locator strip: shows where the chapter sits in the 6-part arc.
%   \locator{<part number 1-6>}{<part title>}
%---------------------------------------------------------------------
\newcommand{\locator}[2]{%
  \normalfigures
  \begingroup
  \noindent\begin{tikzpicture}[baseline]
    \foreach \i in {1,...,6}{
      \pgfmathsetmacro{\xx}{(\i-1)*2.42}
      \ifnum\i=#1
        \node[rounded corners=2pt, fill=primary, text=white, font=\scriptsize\bfseries,
              minimum width=2.3cm, minimum height=0.42cm] at (\xx,0) {Part \i};
      \else
        \node[rounded corners=2pt, fill=primary!10, text=primary!60, font=\scriptsize,
              minimum width=2.3cm, minimum height=0.42cm] at (\xx,0) {Part \i};
      \fi}
  \end{tikzpicture}\\[2pt]
  {\small\itshape\color{secondary}#2}\par\vspace{4pt}
  \endgroup}

%---------------------------------------------------------------------
% Small helpers
%---------------------------------------------------------------------
\newcommand{\term}[1]{\textbf{\textcolor{primary}{#1}}}
\newcommand{\dsref}[1]{Figure~\ref{fig:#1}}
\newcommand{\chref}[1]{Chapter~\ref{ch:#1}}
% Review-question list, restarting per chapter.
\newenvironment{reviewq}

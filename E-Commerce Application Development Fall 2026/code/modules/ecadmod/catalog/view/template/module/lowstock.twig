{# Chapter 19. Twig auto-escapes everything printed with {{ }}, which is why
   Chapter 16's script probes did nothing. Do not reach for |raw here. #}
<div class="card mb-3 ecad-lowstock">
  <div class="card-header">{{ heading_title }}</div>
  <ul class="list-group list-group-flush">
    {% for product in products %}
      <li class="list-group-item d-flex justify-content-between">
        <a href="{{ product.href }}">{{ product.name }}</a>
        <span class="badge bg-warning text-dark">
          {{ product.quantity }} {{ text_left }}
        </span>
      </li>
    {% endfor %}
  </ul>
</div>

# Copy to .env and change anything you like. Compose reads .env automatically.
#
# These are the DEFAULTS the course ships with, and they are deliberately
# weak: "admin" / "admin123" is the kind of credential Chapter 16 goes
# looking for and finds. You are asked to change them in Chapter 16, not
# here, so that you can measure the shop before and after.

SHOP_PORT=8090
ADMINER_PORT=8091

DB_NAME=opencart
DB_USER=shop
DB_PASSWORD=shoppw
DB_ROOT_PASSWORD=rootpw

OC_ADMIN_USER=admin
OC_ADMIN_PASSWORD=admin123
OC_ADMIN_EMAIL=admin@example.com
